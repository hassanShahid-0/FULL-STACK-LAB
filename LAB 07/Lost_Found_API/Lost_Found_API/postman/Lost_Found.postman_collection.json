            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('attachmentId', pm.response.json().attachment.attachmentId);",
              "pm.test('No filesystem path leaked', () => pm.expect(pm.response.json().attachment.path).to.be.undefined);"
            ]
